Include ~/.orbstack/ssh/config

Host portfolio
    HostName {{ onepasswordRead "op://DEV/florianlopes_io_server/ip_address/text" }}
    User {{ onepasswordRead "op://DEV/florianlopes_io_server/username/text" }}
{{- if onepasswordRead "op://DEV/florianlopes_io_server/port/text" }}
    Port {{ onepasswordRead "op://DEV/florianlopes_io_server/port/text" }}
{{- end }}

Host dedibox
    HostName {{ onepasswordRead "op://DEV/dedibox_server/ip_address/text" }}
    User {{ onepasswordRead "op://DEV/dedibox_server/username/text" }}
{{- if onepasswordRead "op://DEV/dedibox_server/port/text" }}
    Port {{ onepasswordRead "op://DEV/dedibox_server/port/text" }}
{{- end }}
