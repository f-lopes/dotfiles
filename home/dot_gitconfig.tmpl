[user]
    name = {{ env "GIT_AUTHOR_NAME" | default "Florian Lopes" | quote }}
    email = {{ env "GIT_AUTHOR_EMAIL" | default "florian.lopes@outlook.com" | quote }}

[init]
    defaultBranch = main

[pull]
    rebase = true

[core]
    excludesfile = ~/.config/git/ignore
[credential "https://github.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh auth git-credential
